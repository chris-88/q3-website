---
import Base from '../layouts/Base.astro'
---

<Base
  title="Page not found"
  description="This page does not exist on the Q3 Interiors website."
  noindex
  bookHref="/#book"
>
  <section class="mx-auto max-w-page px-6 pt-12 pb-20 md:px-10 md:pt-20 md:pb-28">
    <div class="flex max-w-prose flex-col gap-6">
      <h1 class="text-display font-medium tracking-tight">We can't find that page.</h1>
      <p>The link may be old, or the page may have moved.</p>
      <ul class="flex flex-col gap-3 sm:flex-row">
        <li>
          <a href="/" class="btn">
            Go to the home page
          </a>
        </li>
        <li>
          <a href="/our-work/" class="btn btn-secondary">
            See our work
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>
